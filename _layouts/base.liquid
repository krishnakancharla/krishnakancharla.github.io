<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{% if page.title %}{{ page.title }} — {% endif %}{{ site.title }}</title>
  <meta name="author" content="{{ site.title }}" />
  <meta name="description" content="{{ site.description }}" />

  <link rel="icon" type="image/jpeg" href="/images/favicon.jpg" />
  <link rel="stylesheet" href="/css/modern.css" />
</head>
<body>
  <header id="site-header" class="site-navbar" role="banner">
    <div class="site-container navbar-inner">
      <a href="/" class="brand-link">
        <span class="brand-monogram" aria-hidden="true">KK</span>
        <span class="brand-meta">
          <span>{{ site.title }}</span>
          <span class="brand-role">Applied AI @ Google</span>
        </span>
      </a>

      <nav role="navigation" aria-label="Primary Navigation">
        <ul id="primary-nav-links" class="nav-links">
          <li><a href="/" class="nav-link-item">Home</a></li>
          <li><a href="/#my-journey" class="nav-link-item">Experience</a></li>
          <li><a href="/#skills" class="nav-link-item">Expertise</a></li>
          <li><a href="/about/" class="nav-link-item">CV</a></li>
          <li><a href="/blogs/" class="nav-link-item">Articles</a></li>
          <li><a href="/bucketlist/" class="nav-link-item">Bucket List</a></li>
          <li><a href="/#home-footer" class="nav-cta">Get in Touch</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="section-block">
    <div class="site-container">
      {{ content }}
    </div>
  </main>

  <footer class="footer-section" style="padding: 2.5rem 0;">
    <div class="site-container footer-bottom" style="margin-top: 0; border-top: none; padding-top: 0;">
      <div>© {{ site.title }} · Applied AI @ Google · Seattle, WA</div>
      <div style="display: flex; gap: 1.25rem;">
        <a href="/">Home</a>
        <a href="/about/">CV &amp; About</a>
        <a href="/blogs/">Articles</a>
        <a href="/bucketlist/">Bucket List</a>
      </div>
    </div>
  </footer>

  <script src="/js/portfolio.js"></script>
</body>
</html>
